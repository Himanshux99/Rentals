# Copy to .env and fill in. Full list and meaning: docs/PLAN.md "Configuration".
APP_URL=http://localhost:3000

# Neon: use the pooled connection string of a dev branch. DB_DRIVER=neon uses Neon's serverless driver.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DB_DRIVER=pg
# Migrations only: the same string without "-pooler" in the host (prisma migrate needs a direct connection).
# DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# local = files in ./.uploads (debugging). r2 = Cloudflare R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.uploads
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# STORAGE_PUBLIC_BASE_URL=https://images.example.com
UPLOAD_URL_TTL_SECONDS=300
NEXT_PUBLIC_IMAGE_MAX_EDGE=1600
NEXT_PUBLIC_IMAGE_MAX_UPLOAD_MB=5
NEXT_PUBLIC_MAX_IMAGES_PER_PRODUCT=8

# openssl rand -base64 32
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_MAX_AGE_DAYS=30

# console = code printed in the dev server log. msg91 = real SMS.
# false = no phone verification (Google login only). Set true with OTP_DRIVER=msg91 to turn it back on.
PHONE_OTP_ENABLED=false
OTP_DRIVER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
OTP_MAX_PER_PHONE_PER_HOUR=3
OTP_MAX_PER_IP_PER_HOUR=10

# Google accounts that become admins when they first sign in.
ADMIN_EMAILS=himanshu99choyal@gmail.com
DEFAULT_CITY_SLUG=barwani
REPORT_MAX_PER_IP_PER_HOUR=5
STALE_AFTER_DAYS=30
# openssl rand -hex 32. Protects the daily job (/api/cron/daily). Required in production.
# CRON_SECRET=
